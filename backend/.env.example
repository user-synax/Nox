# Copy to .env and fill in. Never commit real secrets.
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/Nox
BETTER_AUTH_SECRET=replace-with-48-plus-random-bytes-min-32-chars
BETTER_AUTH_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
# Google OAuth (PRD §5 future) — set both to enable, then restart.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
