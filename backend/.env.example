# Copy to .env and fill in. Never commit real secrets.
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/Nox
BETTER_AUTH_SECRET=replace-with-48-plus-random-bytes-min-32-chars
BETTER_AUTH_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
# Google OAuth (PRD §5 future) — set both to enable, then restart.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Outbound email (verification + password reset) — Resend.
# Optional in dev (dev-outbox fallback); REQUIRED in production (boot fails without it).
# Verify the sender domain in Resend before prod sends will deliver.
# RESEND_API_KEY=
# EMAIL_FROM=Nox <noreply@nox.synax.me>

# Appwrite avatar storage — set all four to enable uploads, then restart.
# Until then POST /users/me/avatar answers 503 with a clear message.

APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_BUCKET_AVATARS=avatars
APPWRITE_API_KEY=
